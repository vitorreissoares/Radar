{
  "name": "radar",
  "productName": "Radar",
  "version": "1.1.0",
  "description": "Monitoramento de postagens no Instagram: categorização com IA, validação humana e relatório",
  "main": "main.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "org.radar.app",
    "productName": "Radar",
    "artifactName": "Radar-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "carregando.html",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "iniciar.R",
        "to": "iniciar.R"
      },
      {
        "from": "r-env",
        "to": "r",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "..",
        "to": "app",
        "filter": [
          "app.R",
          "LEIA-ME.md",
          "R/**",
          "prompts/**",
          "templates/**",
          "apps_script/**",
          "padrao/**",
          "assets/**",
          "config/candidatos.csv",
          "config/sobre_a_pesquisa.json",
          "config/relatorio_final.html"
        ]
      }
    ],
    "asar": true,
    "afterPack": "build/assinar_mac.js",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Radar",
      "uninstallDisplayName": "Radar",
      "language": "1046",
      "installerLanguages": [
        "pt_BR"
      ],
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Radar"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Equipe Radar <radar@users.noreply.github.com>",
      "synopsis": "Monitoramento de postagens no Instagram"
    },
    "publish": null
  },
  "author": {
    "name": "Equipe Radar",
    "email": "radar@users.noreply.github.com"
  },
  "homepage": "https://github.com/vitorreissoares/Radar",
  "repository": {
    "type": "git",
    "url": "https://github.com/vitorreissoares/Radar.git"
  }
}
